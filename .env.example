# =====================================================================
# Model route. Pick ONE.
# =====================================================================
# A) Through the AI Gateway (default, recommended for demos and AgentCore).
#    Leave ANTHROPIC_API_KEY unset.
# Gateway root WITHOUT the /v1/messages suffix; the SDK appends that itself.
MODEL_BASE_URL=https://<gateway-host>/<anthropic-compatible-root>
MODEL_NAME=<model-name-accepted-by-the-gateway>
MODEL_AUTH_MODE=api_key
# Optional server-side default gateway key. Leave empty to require a key typed in the UI.
MODEL_API_KEY=
# 1 = strip anthropic-beta headers (safer behind a proxy gateway). Set 0 if the gateway wants them.
MODEL_DISABLE_BETAS=1

# B) Direct to Anthropic (dev fallback; BYPASSES the gateway).
#    If ANTHROPIC_API_KEY is set, it wins and MODEL_BASE_URL / MODEL_API_KEY are ignored.
#    Careful: this is a common variable name, so check your shell does not already set it.
ANTHROPIC_API_KEY=
# An Anthropic model ID (gateway model names often differ). Falls back to MODEL_NAME if empty.
ANTHROPIC_MODEL=

# =====================================================================
# Fusion Stock Watchlist MCP server (behind the gateway)
# =====================================================================
MCP_URL=https://<gateway-host>/<fusion-stock-watchlist-mcp-path>
# "http" = streamable HTTP, "sse" = Server-Sent Events. Set whichever the server speaks.
MCP_TRANSPORT=http
# Name the server is registered under; becomes the mcp__<name>__ tool prefix.
MCP_SERVER_NAME=stockwatchlist
MCP_AUTH_MODE=api_key
MCP_API_KEY_HEADER=x-api-key
# Optional server-side default. Leave empty to require a key typed in the UI.
MCP_API_KEY=

# =====================================================================
# Agent
# =====================================================================
AGENT_MAX_TURNS=15

# =====================================================================
# A2A server (python -m app.a2a_server). Port 9000 is also what AgentCore requires.
# =====================================================================
# URL advertised in the agent card. AgentCore and Codespaces set this automatically.
A2A_PUBLIC_URL=
# Bind address. 0.0.0.0 inside containers (the Dockerfiles set it).
A2A_HOST=

# =====================================================================
# Web UI mode
# =====================================================================
# direct: the UI server runs the agent itself (default).
# a2a:    the UI server is an A2A client for A2A_AGENT_URL (needs none of the model/MCP settings above).
AGENT_MODE=direct
# The A2A agent's JSON-RPC endpoint, exactly as its card advertises it:
#   local/Codespace:  http://localhost:9000/
#   AgentCore:        https://bedrock-agentcore.<region>.amazonaws.com/runtimes/<url-encoded-arn>/invocations/
A2A_AGENT_URL=
# none | bearer | sigv4   (AgentCore with IAM auth: sigv4; with a JWT authorizer: bearer)
A2A_AUTH_MODE=none
A2A_BEARER_TOKEN=
A2A_REGION=
