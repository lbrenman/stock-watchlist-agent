# One agent process (python -m app.a2a_server) does all the work: it calls the model and the MCP server.
# The chat UI (uvicorn app.server:app) is only a client for that agent.
# Variables for the agent are in section 1; the chat UI's are in section 2.

# =====================================================================
# 1. THE AGENT
# =====================================================================

# ---- Model route. Pick ONE. ----
# A) Through an Anthropic-compatible proxy, such as Fusion AI Gateway (default; recommended for demos
#    and AgentCore). Leave ANTHROPIC_API_KEY unset.
# Proxy root WITHOUT the /v1/messages suffix; the SDK appends that itself.
MODEL_BASE_URL=https://<gateway-host>/<anthropic-compatible-root>
MODEL_NAME=<model-name-accepted-by-the-proxy>
MODEL_AUTH_MODE=api_key
# The proxy's key. Needed for the proxy route: the chat UI has no model key field, so it must be set here.
# (A direct caller, like the CLI probe, can still override it per request with an X-Model-Key header.)
MODEL_API_KEY=
# 1 = strip anthropic-beta headers (safer behind a proxy). Set 0 if the proxy wants them.
MODEL_DISABLE_BETAS=1

# B) Direct to Anthropic (dev fallback; BYPASSES the gateway).
#    If ANTHROPIC_API_KEY is set, it wins and MODEL_BASE_URL / MODEL_API_KEY are ignored.
#    Careful: this is a common variable name, so check your shell does not already set it.
ANTHROPIC_API_KEY=
# An Anthropic model ID (proxy model names often differ). Falls back to MODEL_NAME if empty.
ANTHROPIC_MODEL=

# ---- Fusion Stock Watchlist MCP server (behind the gateway) ----
MCP_URL=https://<gateway-host>/<fusion-stock-watchlist-mcp-path>
# "http" = streamable HTTP, "sse" = Server-Sent Events. Set whichever the server speaks.
MCP_TRANSPORT=http
# Name the server is registered under; becomes the mcp__<name>__ tool prefix.
MCP_SERVER_NAME=stockwatchlist
MCP_AUTH_MODE=api_key
MCP_API_KEY_HEADER=x-api-key
# Optional default. Leave empty to require callers to send one (X-Mcp-Key); each key has its own watchlist.
MCP_API_KEY=

AGENT_MAX_TURNS=15

# ---- Securing the agent: callers must send "x-api-key: <key>" ----
# Every call except /ping and the agent card is checked. One key, or several separated by commas so you
# can rotate keys with overlap. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = open to anyone who can reach the port (a warning is logged).
AGENT_API_KEYS=
# 1 = refuse to start without a key (the Codespaces config sets this).
AGENT_REQUIRE_API_KEY=0

# ---- Where the agent listens ----
# The public address the agent card advertises. Codespaces fills this in automatically from
# CODESPACE_NAME; set it yourself if the card still says http://localhost:9000/, e.g.
#   A2A_PUBLIC_URL=https://<codespace-name>-9000.app.github.dev/
# (The agent passes it to the AgentCore SDK as AGENTCORE_RUNTIME_URL, which AgentCore sets itself when deployed.)
A2A_PUBLIC_URL=
# Bind address. 0.0.0.0 inside containers (the Dockerfiles and dev container set it).
A2A_HOST=
# Port. AgentCore only reaches port 9000, so leave this alone unless you are just testing locally.
A2A_PORT=

# =====================================================================
# 2. THE CHAT UI (also the CLI probe: python -m app.a2a_client "...")
# =====================================================================
# The agent to talk to, exactly as its card advertises it. Default: the agent on this machine.
#   local / Codespace:  http://localhost:9000/
#   AgentCore:          https://bedrock-agentcore.<region>.amazonaws.com/runtimes/<url-encoded-arn>/invocations/
A2A_AGENT_URL=
# How to authenticate to the agent's host. none | bearer | sigv4
#   AgentCore with IAM auth: sigv4 (AWS credentials in the environment). With a JWT authorizer: bearer.
A2A_AUTH_MODE=none
A2A_BEARER_TOKEN=
A2A_REGION=
# The x-api-key the chat UI server sends to the agent (one of its AGENT_API_KEYS).
# If empty, the first AGENT_API_KEYS entry is used, so one .env works for both programs.
# Set it explicitly when the UI runs apart from the agent. A key typed in the UI's Settings overrides it.
A2A_API_KEY=
